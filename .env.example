# Copy to .env (not committed), then load it before running the API:
#   set -a; source .env; set +a; cargo run -p tradocraft-api
DATABASE_URL=postgresql://tradocraft:tradocraft@localhost/tradocraft

# oidc (default) or dev. Dev trusts the X-Dev-User header: local development only.
# The API refuses dev mode on a non-loopback BIND_ADDR unless ALLOW_INSECURE_DEV_AUTH=true.
AUTH_MODE=dev
DEV_DEFAULT_USER=
# For AUTH_MODE=oidc, e.g. Microsoft Entra ID:
#   OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
#   OIDC_AUDIENCE=<api application id>
OIDC_ISSUER=
OIDC_AUDIENCE=

# Demo company and well-known users; only allowed with AUTH_MODE=dev.
SEED_DEV_DATA=true
# Optional directory of *.sql files run (in file-name order) right after the development seed,
# e.g. demo data kept outside this repository. Ignored unless the development seed is loaded.
# The seed only runs once, on an empty database: set this before that first start. Setting it
# later and restarting the API does not run the files (start from an empty database instead).
EXTRA_SEED_DIR=
BIND_ADDR=127.0.0.1:8080
# Which environment this instance is (ADR 0043); shown by the app in a coloured banner and
# returned by GET /api/v1/meta/environment (readable without signing in).
# APP_ENV_KIND: live (default), test or tutorial; any other value stops the API at start-up.
# APP_ENV_NAME: display name; defaults to the name of the database.
APP_ENV_KIND=live
APP_ENV_NAME=
TYPST_BIN=typst
# Directory with the Typst document templates (quotation.typ, order_confirmation.typ, ...).
# Point it at a copy to use your own layout; the data each template receives is documented at the
# top of the template and in crates/*/src/*pdf*.rs / order_doc.rs.
TEMPLATE_DIR=templates

# Worker (cargo run -p tradocraft-worker)
MAIL_TRANSPORT=files
MAIL_FILES_DIR=outbox
# MAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURITY=starttls   # starttls | tls | none (none only for a local test server)
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=
# IMAP_MAILBOX=INBOX
# IMAP_TLS=true            # false only for a local test server
# HELPDESK_COMPANY_ID=
POLL_SECONDS=30

# Outside APP_ENV_KIND=live the worker forces MAIL_TRANSPORT=files and does not poll IMAP (ADR 0048).
# Set to 1 only for a dedicated test mailbox: polling marks mail as read there.
# ALLOW_INBOUND_MAIL_IN_NON_LIVE=1

# scripts/envctl (test environment clones; see docs/runbooks/test-environments.md)
# ENVCTL_DIR=~/.local/share/tradocraft-envs
# ENVCTL_PORT_MIN=8100
# ENVCTL_PORT_MAX=8199
# ENVCTL_API_BIN=target/release/tradocraft-api
# ENVCTL_WORKER_BIN=target/release/tradocraft-worker
